# Supabase (Obrigatório)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui

# Supabase Service Role (BACKEND ONLY - nunca expor no client!)
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# Cakto Checkout URLs (públicos - ok no client)
VITE_CAKTO_CHECKOUT_MONTHLY=https://pay.cakto.com.br/seu-slug-mensal
VITE_CAKTO_CHECKOUT_ANNUAL=https://pay.cakto.com.br/seu-slug-anual
VITE_CAKTO_CHECKOUT_LIFETIME=https://pay.cakto.com.br/seu-slug-vitalicio

# Cakto API (BACKEND ONLY - nunca expor no client!)
CAKTO_CLIENT_ID=seu_client_id
CAKTO_CLIENT_SECRET=seu_client_secret
CAKTO_WEBHOOK_SECRET=seu_webhook_secret_opcional
