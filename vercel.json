{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server-build/**"
    },
    "api/**/*.ts": {
      "includeFiles": "server-build/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/webhooks/(.*)", "dest": "/api/webhooks/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
