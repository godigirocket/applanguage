import { createFileRoute } from "@tanstack/react-router";
import { useEffect, useState, useRef } from "react";
import { AppHeader } from "@/components/lume/AppHeader";
import { useAuth } from "@/lib/auth";
import { useStore } from "@/hooks/useStore";
import { supabase } from "@/integrations/supabase/client";
import { MessageCircle, Send, Users } from "@/components/lume/CustomIcons";
import { toast } from "sonner";

export const Route = createFileRoute("/community/old")({
  component: CommunityPageWrapper,
});

// Wrapper component for SSR safety
function CommunityPageWrapper() {
  // SSR protection
  if (typeof window === "undefined") {
    return (
      <div style={{ minHeight: "100vh", background: "#F7F4EF" }}>
        <div style={{ padding: "40px", textAlign: "center" }}>
          <p style={{ color: "#333" }}>Loading...</p>
        </div>
      </div>
    );
  }

  return <CommunityPage />;
}

interface ChatMessage {
  id: string;
  user_id: string;
  message: string;
  created_at: string;
  profiles?: {
    full_name: string;
    level: string;
  };
}

// Seed messages to simulate an active community
const SEED_MESSAGES: Omit<ChatMessage, "id" | "user_id">[] = [
  {
    message: "Alguém pode me ajudar com phrasal verbs? Sempre me confundo! 😅",
    created_at: new Date(Date.now() - 25 * 60 * 1000).toISOString(),
    profiles: { full_name: "Ana Silva", level: "intermediário" },
  },
  {
    message: "I'm practicing Spanish pronunciation. Does anyone have tips for rolling the R?",
    created_at: new Date(Date.now() - 22 * 60 * 1000).toISOString(),
    profiles: { full_name: "Mike Chen", level: "beginner" },
  },
  {
    message: "¡Hola! Estoy buscando compañeros para practicar conversación en inglés 🗣️",
    created_at: new Date(Date.now() - 18 * 60 * 1000).toISOString(),
    profiles: { full_name: "Carlos Méndez", level: "avançado" },
  },
  {
    message: "Acabei de completar 30 dias de ofensiva! A consistência é tudo 🔥",
    created_at: new Date(Date.now() - 15 * 60 * 1000).toISOString(),
    profiles: { full_name: "Julia Rodrigues", level: "intermediário" },
  },
  {
    message: "Does anyone know good movies for learning English? I prefer comedy 🎬",
    created_at: new Date(Date.now() - 12 * 60 * 1000).toISOString(),
    profiles: { full_name: "Yuki Tanaka", level: "beginner" },
  },
  {
    message: "Dica: assistir séries com legendas no idioma que você está aprendendo ajuda MUITO! 📺",
    created_at: new Date(Date.now() - 10 * 60 * 1000).toISOString(),
    profiles: { full_name: "Pedro Santos", level: "avançado" },
  },
  {
    message: "I'm struggling with Portuguese verb conjugations... there are so many tenses! 😰",
    created_at: new Date(Date.now() - 8 * 60 * 1000).toISOString(),
    profiles: { full_name: "Emma Johnson", level: "intermediário" },
  },
  {
    message: "Alguém mais acha que falar sozinho em voz alta ajuda na pronúncia? Eu faço isso todo dia!",
    created_at: new Date(Date.now() - 6 * 60 * 1000).toISOString(),
    profiles: { full_name: "Lucas Ferreira", level: "avançado" },
  },
  {
    message: "Just had my first full conversation in Spanish without switching to English! 🎉",
    created_at: new Date(Date.now() - 4 * 60 * 1000).toISOString(),
    profiles: { full_name: "Sophie Martin", level: "intermediário" },
  },
  {
    message: "Alguém conhece boas músicas em inglês para treinar listening? Gosto de pop e rock 🎵",
    created_at: new Date(Date.now() - 2 * 60 * 1000).toISOString(),
    profiles: { full_name: "Maria Costa", level: "beginner" },
  },
];

function CommunityPage() {
  const { user } = useAuth();
  const { interfaceLanguage } = useStore();
  const [messages, setMessages] = useState<ChatMessage[]>([]);
  const [newMessage, setNewMessage] = useState("");
  const [loading, setLoading] = useState(true);
  const [sending, setSending] = useState(false);
  const [onlineCount, setOnlineCount] = useState(0);
  const [someoneTyping, setSomeoneTyping] = useState(false);
  const messagesEndRef = useRef<HTMLDivElement>(null);

  const isPT = interfaceLanguage === "pt";
  const isES = interfaceLanguage === "es";

  const t = {
    title: isPT ? "Comunidade" : isES ? "Comunidad" : "Community",
    subtitle: isPT
      ? "Converse e pratique com outros estudantes"
      : isES
        ? "Conversa y practica con otros estudiantes"
        : "Chat and practice with other students",
    placeholder: isPT
      ? "Digite sua mensagem..."
      : isES
        ? "Escribe tu mensaje..."
        : "Type your message...",
    send: isPT ? "Enviar" : isES ? "Enviar" : "Send",
    online: isPT ? "online" : isES ? "en línea" : "online",
    loginRequired: isPT
      ? "Faça login para conversar"
      : isES
        ? "Inicia sesión para chatear"
        : "Login to chat",
    you: isPT ? "Você" : isES ? "Tú" : "You",
    justNow: isPT ? "agora" : isES ? "ahora" : "just now",
  };

  useEffect(() => {
    if (typeof window === "undefined") return; // SSR protection
    
    if (!user) {
      setLoading(false);
      return;
    }

    loadMessages();
    subscribeToMessages();
    updateOnlineCount();

    // Update online count every 30 seconds
    const interval = setInterval(updateOnlineCount, 30000);
    
    // Simulate "someone is typing" effect randomly
    const typingInterval = setInterval(() => {
      if (Math.random() > 0.7) {
        setSomeoneTyping(true);
        setTimeout(() => setSomeoneTyping(false), 3000 + Math.random() * 2000);
      }
    }, 15000);

    return () => {
      clearInterval(interval);
      clearInterval(typingInterval);
    };
  }, [user]);

  useEffect(() => {
    if (typeof window === "undefined") return; // SSR protection
    scrollToBottom();
  }, [messages]);

  const loadMessages = async () => {
    if (typeof window === "undefined") return;
    
    try {
      const { data, error } = await supabase
        .from("chat_messages")
        .select(`
          *,
          profiles:user_id (
            full_name,
            level
          )
        `)
        .order("created_at", { ascending: true })
        .limit(100);

      if (error) throw error;

      const dbMessages = (data as any) || [];
      
      // If no messages in DB, show seed messages
      if (dbMessages.length === 0) {
        const seedWithIds = SEED_MESSAGES.map((msg, idx) => ({
          ...msg,
          id: `seed-${idx}`,
          user_id: `seed-user-${idx}`,
        }));
        setMessages(seedWithIds as any);
      } else {
        setMessages(dbMessages);
      }
    } catch (error) {
      console.error("Error loading messages:", error);
      // On error, show seed messages as fallback
      const seedWithIds = SEED_MESSAGES.map((msg, idx) => ({
        ...msg,
        id: `seed-${idx}`,
        user_id: `seed-user-${idx}`,
      }));
      setMessages(seedWithIds as any);
    } finally {
      setLoading(false);
    }
  };

  const subscribeToMessages = () => {
    try {
      const channel = supabase
        .channel("chat_messages")
        .on(
          "postgres_changes",
          {
            event: "INSERT",
            schema: "public",
            table: "chat_messages",
          },
          async (payload) => {
            try {
              // Fetch profile data for the new message
              const { data: profile } = await supabase
                .from("profiles")
                .select("full_name, level")
                .eq("id", payload.new.user_id)
                .single();

              const newMsg = {
                ...payload.new,
                profiles: profile,
              } as ChatMessage;

              setMessages((prev) => [...prev, newMsg]);
            } catch (error) {
              console.error("Error fetching profile for message:", error);
            }
          }
        )
        .subscribe();

      return () => {
        channel.unsubscribe();
      };
    } catch (error) {
      console.error("Error subscribing to messages:", error);
    }
  };

  const updateOnlineCount = async () => {
    if (typeof window === "undefined") return;
    
    try {
      const { count } = await supabase
        .from("profiles")
        .select("*", { count: "exact", head: true })
        .gte("last_session_date", new Date(Date.now() - 5 * 60 * 1000).toISOString());

      // If we can't get real count, show a simulated active count
      const activeCount = count || Math.floor(Math.random() * 15) + 12; // 12-26 online
      setOnlineCount(activeCount);
    } catch (error) {
      console.error("Error getting online count:", error);
      // Fallback to simulated count
      setOnlineCount(Math.floor(Math.random() * 15) + 12);
    }
  };

  const scrollToBottom = () => {
    if (typeof window === "undefined") return;
    messagesEndRef.current?.scrollIntoView({ behavior: "smooth" });
  };

  const handleSendMessage = async (e: React.FormEvent) => {
    e.preventDefault();

    if (typeof window === "undefined") return;
    if (!user || !newMessage.trim()) return;

    setSending(true);

    try {
      const { error } = await supabase.from("chat_messages").insert({
        user_id: user.id,
        message: newMessage.trim(),
      });

      if (error) throw error;

      setNewMessage("");
    } catch (error: any) {
      console.error("Error sending message:", error);
      toast.error(isPT ? "Erro ao enviar mensagem" : isES ? "Error al enviar mensaje" : "Error sending message");
    } finally {
      setSending(false);
    }
  };

  const formatTime = (timestamp: string) => {
    const date = new Date(timestamp);
    const now = new Date();
    const diffMinutes = Math.floor((now.getTime() - date.getTime()) / 60000);

    if (diffMinutes < 1) return t.justNow;
    if (diffMinutes < 60) return `${diffMinutes}m`;
    if (diffMinutes < 1440) return `${Math.floor(diffMinutes / 60)}h`;
    return date.toLocaleDateString();
  };

  if (!user) {
    return (
      <div style={{ minHeight: "100vh", background: "var(--bg)" }}>
        <AppHeader />
        <main
          style={{
            maxWidth: "600px",
            margin: "0 auto",
            padding: "80px 24px",
            textAlign: "center",
          }}
        >
          <MessageCircle size={64} color="var(--text-secondary)" style={{ marginBottom: "16px" }} />
          <h2
            style={{
              fontSize: "28px",
              fontWeight: 800,
              color: "var(--text-primary)",
              marginBottom: "12px",
            }}
          >
            {t.loginRequired}
          </h2>
          <p style={{ fontSize: "16px", color: "var(--text-secondary)" }}>
            {isPT
              ? "Faça login para conversar com outros estudantes"
              : isES
                ? "Inicia sesión para chatear con otros estudiantes"
                : "Login to chat with other students"}
          </p>
        </main>
      </div>
    );
  }

  return (
    <div style={{ minHeight: "100vh", background: "var(--bg)", display: "flex", flexDirection: "column" }}>
      <AppHeader />

      {/* Header */}
      <div
        style={{
          background: "var(--surface-raised)",
          borderBottom: "1px solid var(--border)",
          padding: "20px 24px",
        }}
      >
        <div style={{ maxWidth: "1000px", margin: "0 auto" }}>
          <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between" }}>
            <div>
              <h1
                style={{
                  fontSize: "28px",
                  fontWeight: 900,
                  color: "var(--text-primary)",
                  marginBottom: "4px",
                }}
              >
                {t.title}
              </h1>
              <p style={{ fontSize: "14px", color: "var(--text-secondary)", margin: 0 }}>
                {t.subtitle}
              </p>
            </div>

            <div
              style={{
                display: "flex",
                alignItems: "center",
                gap: "8px",
                padding: "8px 16px",
                background: "rgba(39,174,96,0.1)",
                borderRadius: "99px",
              }}
            >
              <Users size={16} color="#27AE60" />
              <span style={{ fontSize: "14px", fontWeight: 700, color: "#27AE60" }}>
                {onlineCount} {t.online}
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Messages */}
      <main
        style={{
          flex: 1,
          maxWidth: "1000px",
          width: "100%",
          margin: "0 auto",
          padding: "24px",
          overflowY: "auto",
        }}
      >
        {loading ? (
          <div style={{ textAlign: "center", padding: "40px" }}>
            <div
              style={{
                width: "32px",
                height: "32px",
                border: "3px solid var(--border)",
                borderTopColor: "var(--brand)",
                borderRadius: "50%",
                animation: "spin 0.6s linear infinite",
                margin: "0 auto",
              }}
            />
          </div>
        ) : messages.length === 0 ? (
          <div style={{ textAlign: "center", padding: "40px" }}>
            <MessageCircle size={48} color="var(--text-secondary)" style={{ marginBottom: "12px" }} />
            <p style={{ fontSize: "16px", color: "var(--text-secondary)" }}>
              {isPT
                ? "Seja o primeiro a enviar uma mensagem!"
                : isES
                  ? "¡Sé el primero en enviar un mensaje!"
                  : "Be the first to send a message!"}
            </p>
          </div>
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: "16px" }}>
            {messages.map((msg) => {
              const isOwn = msg.user_id === user.id;
              const userName = isOwn ? t.you : msg.profiles?.full_name || "User";
              const userLevel = msg.profiles?.level || "beginner";

              return (
                <div
                  key={msg.id}
                  style={{
                    display: "flex",
                    flexDirection: "column",
                    alignItems: isOwn ? "flex-end" : "flex-start",
                  }}
                >
                  {/* User info */}
                  <div
                    style={{
                      display: "flex",
                      alignItems: "center",
                      gap: "8px",
                      marginBottom: "6px",
                    }}
                  >
                    <div
                      style={{
                        width: "24px",
                        height: "24px",
                        borderRadius: "50%",
                        background: isOwn ? "var(--brand)" : "#4A90E2",
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        fontSize: "12px",
                        fontWeight: 700,
                        color: "white",
                      }}
                    >
                      {userName[0].toUpperCase()}
                    </div>
                    <span
                      style={{
                        fontSize: "13px",
                        fontWeight: 700,
                        color: "var(--text-primary)",
                      }}
                    >
                      {userName}
                    </span>
                    <span
                      style={{
                        fontSize: "11px",
                        padding: "2px 8px",
                        background: "var(--border)",
                        borderRadius: "4px",
                        color: "var(--text-secondary)",
                        fontWeight: 600,
                        textTransform: "uppercase",
                      }}
                    >
                      {userLevel}
                    </span>
                    <span style={{ fontSize: "12px", color: "var(--text-secondary)" }}>
                      {formatTime(msg.created_at)}
                    </span>
                  </div>

                  {/* Message bubble */}
                  <div
                    style={{
                      maxWidth: "70%",
                      padding: "12px 16px",
                      borderRadius: "16px",
                      background: isOwn
                        ? "var(--brand)"
                        : "var(--surface-raised)",
                      color: isOwn ? "white" : "var(--text-primary)",
                      fontSize: "15px",
                      lineHeight: 1.5,
                      wordBreak: "break-word",
                    }}
                  >
                    {msg.message}
                  </div>
                </div>
              );
            })}
            
            {/* Someone is typing indicator */}
            {someoneTyping && (
              <div
                style={{
                  display: "flex",
                  flexDirection: "column",
                  alignItems: "flex-start",
                }}
              >
                <div
                  style={{
                    display: "flex",
                    alignItems: "center",
                    gap: "8px",
                    marginBottom: "6px",
                  }}
                >
                  <div
                    style={{
                      width: "24px",
                      height: "24px",
                      borderRadius: "50%",
                      background: "#9B59B6",
                      display: "flex",
                      alignItems: "center",
                      justifyContent: "center",
                      fontSize: "12px",
                      fontWeight: 700,
                      color: "white",
                    }}
                  >
                    ?
                  </div>
                  <span
                    style={{
                      fontSize: "13px",
                      fontWeight: 700,
                      color: "var(--text-secondary)",
                      fontStyle: "italic",
                    }}
                  >
                    {isPT ? "Alguém está digitando..." : isES ? "Alguien está escribiendo..." : "Someone is typing..."}
                  </span>
                </div>
                <div
                  style={{
                    padding: "12px 16px",
                    borderRadius: "16px",
                    background: "var(--surface-raised)",
                    display: "flex",
                    gap: "4px",
                  }}
                >
                  <span
                    className="typing-dot"
                    style={{
                      width: "8px",
                      height: "8px",
                      borderRadius: "50%",
                      background: "var(--text-secondary)",
                      animation: "typing 1.4s infinite",
                    }}
                  />
                  <span
                    className="typing-dot"
                    style={{
                      width: "8px",
                      height: "8px",
                      borderRadius: "50%",
                      background: "var(--text-secondary)",
                      animation: "typing 1.4s infinite 0.2s",
                    }}
                  />
                  <span
                    className="typing-dot"
                    style={{
                      width: "8px",
                      height: "8px",
                      borderRadius: "50%",
                      background: "var(--text-secondary)",
                      animation: "typing 1.4s infinite 0.4s",
                    }}
                  />
                </div>
              </div>
            )}
            
            <div ref={messagesEndRef} />
          </div>
        )}
      </main>

      {/* Input */}
      <div
        style={{
          background: "var(--surface-raised)",
          borderTop: "1px solid var(--border)",
          padding: "16px 24px",
        }}
      >
        <form
          onSubmit={handleSendMessage}
          style={{
            maxWidth: "1000px",
            margin: "0 auto",
            display: "flex",
            gap: "12px",
          }}
        >
          <input
            type="text"
            value={newMessage}
            onChange={(e) => setNewMessage(e.target.value)}
            placeholder={t.placeholder}
            disabled={sending}
            style={{
              flex: 1,
              padding: "14px 16px",
              borderRadius: "12px",
              border: "1.5px solid var(--border)",
              background: "var(--bg)",
              color: "var(--text-primary)",
              fontSize: "15px",
              outline: "none",
            }}
          />

          <button
            type="submit"
            disabled={sending || !newMessage.trim()}
            style={{
              padding: "14px 24px",
              borderRadius: "12px",
              border: "none",
              background: sending || !newMessage.trim() ? "var(--border)" : "var(--brand)",
              color: "white",
              fontSize: "15px",
              fontWeight: 700,
              cursor: sending || !newMessage.trim() ? "not-allowed" : "pointer",
              display: "flex",
              alignItems: "center",
              gap: "8px",
              transition: "all 0.2s",
            }}
          >
            <Send size={18} />
            {t.send}
          </button>
        </form>
      </div>

      <style>{`
        @keyframes spin {
          to { transform: rotate(360deg); }
        }
        @keyframes typing {
          0%, 60%, 100% {
            transform: translateY(0);
            opacity: 0.7;
          }
          30% {
            transform: translateY(-10px);
            opacity: 1;
          }
        }
      `}</style>
    </div>
  );
}
